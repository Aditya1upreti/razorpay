# ============================================
# Sentinel — .gitignore
# ============================================

# Secrets / credentials
.env
*.pem
*.key

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.pycache
.Python

# Virtual environments
.venv/
.venv_test/
.test-venv/
venv/
env/
ENV/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing / Coverage
.coverage
.pytest_cache/
htmlcov/
coverage.xml

# Temporary audit/debug scripts (generated during development sessions,
# not part of the project source)
.tmp_dep_check.py
_check_api_key.py
_check_cache.py
check_cache.py
diagnose_nondeterminism.py

# One-off throwaway scripts from dev/audit sessions
_*.py

# API response cache (regenerated by evaluate.py — do not commit)
cache/

# Results — all generated artifacts (regenerated on each run)
results/*.json
results/*.csv
results/*.png
results/*.pdf
results/calibration_report.md
results/evaluation_report.md

# evaluation_report.md intentional tracking note:
# If you want to track evaluation_report.md as a human-readable summary
# for judges/reviewers, remove the line above and commit it manually.
# Default here is to ignore it since it drifts every evaluate.py run.

# Data — generated datasets (regenerated by generate_dataset.py with
# SEED=42, reproducible from source — do not commit large CSVs)
# INTENTIONAL EXCEPTION: transactions_test.csv, transactions_train.csv,
# account_relationships.csv ARE committed because the dashboard depends
# on them at runtime and judges need them to run the project.
# Only ignore calibration set which is secondary:
data/transactions_calibration.csv
data/account_relationships_calibration.csv

# Streamlit
.streamlit/secrets.toml

# Node (if any JS tooling is added later)
node_modules/

# Logs
*.log
logs/
.test-venv/
.pytest_cache/
htmlcov/
.coveragegi