# Sentinel — API Key Configuration
# ==================================
# Add multiple Gemini API keys for automatic rotation when one hits
# quota limits. Keys are tried in order; exhausted keys are skipped
# automatically.
#
# Option A: Single key (simplest — works immediately)
#   Set GEMINI_API_KEY below. The system uses it as the sole key.
#
# Option B: Multi-key rotation (recommended for production)
#   Set GEMINI_API_KEY_1 through GEMINI_API_KEY_10.
#   The system tries key 1 first; on quota/rate/auth errors it
#   automatically rotates to the next key without crashing.

# --- Option A: Single key ---
GEMINI_API_KEY=your_key_here

# --- Option B: Multi-key rotation (uncomment to enable) ---
# GEMINI_API_KEY_1=your_first_key_here
# GEMINI_API_KEY_2=your_second_key_here
# GEMINI_API_KEY_3=your_third_key_here
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# GEMINI_API_KEY_6=
# GEMINI_API_KEY_7=
# GEMINI_API_KEY_8=
# GEMINI_API_KEY_9=
# GEMINI_API_KEY_10=
